# PostgreSQL
PG_DB_NAME=atix_backend
PG_USERNAME=postgres
PG_PASSWORD=your_secure_password

# Cloudinary
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# Mailgun
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_SENDER=noreply@yourdomain.com

# JWT (minimum 256 bits)
JWT_SECRET=your_very_secure_jwt_secret_key_at_least_256_bits

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Frontend API URL (relative path when using nginx proxy)
VITE_API_URL=/api
